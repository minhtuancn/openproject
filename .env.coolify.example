# OpenProject Coolify/Production Deployment Environment Variables
# Copy this file and configure for your deployment

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# OpenProject Version
# For version 17.1 as requested
OPENPROJECT_VERSION=17.1

# Database Password
# IMPORTANT: Change this to a strong, unique password!
# Generate with: openssl rand -base64 32
DATABASE_PASSWORD=changeme_to_secure_password

# Secret Key Base
# CRITICAL: Must be a long random string
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=changeme_to_long_random_string_at_least_128_characters

# Domain Configuration
# This is your ONE domain that users will access
# Example: openproject.yourdomain.com
OPENPROJECT_HOST__NAME=openproject.example.com

# HTTPS Configuration
# Set to true if using HTTPS (recommended, Coolify provides Let's Encrypt)
OPENPROJECT_HTTPS=true

# Default Language
# Supported: en, de, fr, es, pt, ru, zh, ja, ko, vi, etc.
# This sets the language for initial data and default for new users
OPENPROJECT_DEFAULT__LANGUAGE=en

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# Port Configuration
# Default is 8080, change if needed
# In Coolify, you typically map this to 80 in your service configuration
PORT=8080

# Web Workers
# Number of web server workers (adjust based on available RAM)
# Each worker uses approximately 512MB RAM
# Default: 2 (requires ~1GB RAM for web service)
OPENPROJECT_WEB_WORKERS=2

# =============================================================================
# EMAIL CONFIGURATION (Optional but recommended)
# =============================================================================
# Uncomment and configure if you want to send emails

# Email Delivery Method
# OPENPROJECT_EMAIL__DELIVERY__METHOD=smtp

# SMTP Server Configuration
# OPENPROJECT_SMTP__ADDRESS=smtp.gmail.com
# OPENPROJECT_SMTP__PORT=587
# OPENPROJECT_SMTP__DOMAIN=example.com

# SMTP Authentication
# OPENPROJECT_SMTP__AUTHENTICATION=plain
# OPENPROJECT_SMTP__USER__NAME=your-email@example.com
# OPENPROJECT_SMTP__PASSWORD=your-smtp-password

# SMTP Security
# OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=true

# Sender Email Address
# OPENPROJECT_MAIL__FROM=openproject@example.com

# =============================================================================
# ADVANCED CONFIGURATION (Usually not needed)
# =============================================================================

# Attachments Storage
# Default is local filesystem, can be configured for S3, etc.
# See: https://www.openproject.org/docs/installation-and-operations/configuration/

# Session Store
# Default is file-based, memcached is used automatically when available
# OPENPROJECT_RAILS__CACHE__STORE=memcache

# Logging
# OPENPROJECT_RAILS__LOG__LEVEL=info

# =============================================================================
# NOTES FOR COOLIFY DEPLOYMENT
# =============================================================================
# 
# 1. You only need ONE domain! Set it in OPENPROJECT_HOST__NAME
# 2. In Coolify, configure the same domain in the service settings
# 3. Enable HTTPS in Coolify (Let's Encrypt is automatic)
# 4. The web service exposes port 80 internally, map it to your needs
# 5. All other services (worker, cron, db, cache) run internally
# 6. No need to expose separate domains for backend, frontend, worker, etc.
#
# For detailed instructions, see:
# - COOLIFY-DEPLOYMENT.md (quick start)
# - docs/installation-and-operations/installation/coolify/README.md (full guide)
